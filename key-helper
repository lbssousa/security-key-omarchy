class SshConfigError(Exception):
    """An SSH configuration file the helper must leave alone; code is the overlay's."""

    def __init__(self, code, detail=""):
        super().__init__(detail)
        self.code = code
        self.detail = detail


def replace_file(path, text, mode):
    """Writes <path> whole, or not at all."""
    fd, temporary = tempfile.mkstemp(prefix="." + os.path.basename(path) + "-", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        if os.path.exists(temporary):
            os.unlink(temporary)
        raise


class Result:
    def __init__(self, code, out="", err=""):
        self.code = code
        self.out = out
        self.err = err


class Runner:
    """Runs one program at a time for an operation; cancel() kills it."""

    def __init__(self):
        self.proc = None

    async def run(self, args, stdin=None, env=None, cwd=None, timeout=None):
        try:
            proc = await asyncio.create_subprocess_exec(
                *args, stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE, env=env, cwd=cwd, start_new_session=True)
        except FileNotFoundError:
            return Result(127, "", "%s: not found" % args[0])
        self.proc = proc
        try:
            out, err = await asyncio.wait_for(proc.communicate(stdin.encode() if stdin else b""), timeout)
        except asyncio.TimeoutError:
            self.kill(proc)
            await proc.wait()
            return Result(-1, "", "timeout")
        finally:
            if self.proc is proc:
                self.proc = None
        return Result(proc.returncode, out.decode("utf-8", "replace"), err.decode("utf-8", "replace"))

    def kill(self, proc=None):
        proc = proc or self.proc
        if proc is not None and proc.returncode is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass

    def cancel(self):
        self.kill()


class Paths:
    def __init__(self, home=None, config=None, pam_dirs=None, runtime=None, shared_helper=None,
                 shared_authfile=SHARED_AUTHFILE, pam_helper=None):
        self.home = home or os.path.expanduser("~")
        # pam_u2f's default authfile: $XDG_CONFIG_HOME/Yubico/u2f_keys, else ~/.config.
        self.config = config or os.environ.get("XDG_CONFIG_HOME") or os.path.join(self.home, ".config")
        self.pam_dirs = pam_dirs or ["/etc/pam.d", "/usr/lib/pam.d"]
        self.runtime = runtime or os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
        # An absolute path: pkexec matches it against the polkit action's.
        self.shared_helper = shared_helper if shared_helper is not None else (shutil.which(SHARED_HELPER) or "")
        self.shared_authfile = shared_authfile
        self.pam_helper = pam_helper if pam_helper is not None else (shutil.which(PAM_HELPER) or "")

    @property
    def authfile(self):
        return os.path.join(self.config, "Yubico", "u2f_keys")

    @property
    def ssh(self):
        return os.path.join(self.home, ".ssh")

    def pam_file(self, service):
        for directory in self.pam_dirs:
            path = os.path.join(directory, service)
            if os.path.isfile(path):
                return path
        return ""


class Session:
    def __init__(self, runner, emit, paths, user, askpass_command):
        self.runner = runner
        self.emit = emit
        self.paths = paths
        self.user = user
        self.askpass_command = askpass_command
        self.op = None
        self.task = None
        # A command that arrived while a refresh (or the hot-plug poll) ran.
        self.queued = None
        self.devices = []
        self.card = None
        self.primary = ""
        self.closed = False

    # -- commands --------------------------------------------------------

    def handle_line(self, line):
        line = line.strip()
        if not line:
            return
        try:
            command = json.loads(line)
        except ValueError:
            log("ignoring invalid JSON")
            return
        if not isinstance(command, dict):
            return
        name = command.get("cmd")
        pin = command.get("pin") if isinstance(command.get("pin"), str) else ""
        if name == "cancel":
            self.cancel()
        elif name == "refresh":
            self.start("refresh", self.refresh())
        elif name == "fido.register":
            self.start(name, self.fido_register(pin))
        elif name == "fido.remove" and isinstance(command.get("index"), int):
            self.start(name, self.fido_remove(command["index"]))
        elif name == "fido.pin" and isinstance(command.get("require"), bool):
            self.start(name, self.fido_pin(command["require"]))
        elif name == "gpg.import":
            self.start(name, self.gpg_import())
        elif name == "gpg.trust":
            self.start(name, self.gpg_trust())
        elif name == "gpg.remove":
            self.start(name, self.gpg_remove())
        elif name == "ssh.import":
            self.start(name, self.ssh_import(pin))
        elif name == "ssh.remove" and isinstance(command.get("name"), str):
            self.start(name, self.ssh_remove(command["name"]))
        elif name == "ssh.create" and isinstance(command.get("options"), dict):
            self.start(name, self.ssh_create(command["options"], pin))
        elif name == "ssh.delete" and isinstance(command.get("name"), str):
            self.start(name, self.ssh_delete(command["name"], pin))
        elif name == "ssh.host" and isinstance(command.get("name"), str) and isinstance(command.get("enable"), bool):
            minutes = command.get("minutes")
            self.start(name, self.ssh_host(command["name"], command["enable"],
                                           minutes if type(minutes) is int else None))
        elif name == "ssh.persist" and isinstance(command.get("name"), str) and type(command.get("minutes")) is int:
            self.start(name, self.ssh_persist(command["name"], command["minutes"]))

    def start(self, op, coroutine):
        if self.op == "refresh" and op != "refresh" and self.queued is None and not self.closed:
            self.queued = (op, coroutine)
            return True
        if self.op is not None or self.closed:
            coroutine.close()
            return False
        self.op = op
        self.task = asyncio.ensure_future(self.guard(op, coroutine))
        return True

    async def guard(self, op, coroutine):
        try:
            await coroutine
        except asyncio.CancelledError:
            self.emit({"type": "cancelled", "op": op})
        except Exception as e:  # noqa: BLE001 - report, keep serving
            log("%s failed: %r" % (op, e))
            self.emit({"type": "error", "op": op, "code": "generic", "detail": str(e)})
        finally:
            self.op = None
            self.task = None
            queued, self.queued = self.queued, None
            if queued is not None:
                self.start(*queued)

    def cancel(self):
        if self.queued is not None:
            op, coroutine = self.queued
            self.queued = None
            coroutine.close()
            self.emit({"type": "cancelled", "op": op})
            return
        if self.task is not None and self.op != "refresh":
            self.runner.cancel()
            self.task.cancel()

    def shutdown(self):
        self.closed = True
        if self.queued is not None:
            self.queued[1].close()
            self.queued = None
        if self.task is not None:
            self.runner.cancel()
            self.task.cancel()

    def fail(self, op, code, detail=""):
        self.emit({"type": "error", "op": op, "code": code, "detail": detail})

    # -- state -----------------------------------------------------------

    async def list_devices(self):
        result = await self.runner.run(["fido2-token", "-L"], timeout=PROBE_TIMEOUT_S)
        return parse_devices(result.out) if result.code == 0 else []

    async def refresh(self):
        devices = await self.list_devices()
        for device in devices:
            info = await self.runner.run(["fido2-token", "-I", device["path"]], timeout=PROBE_TIMEOUT_S)
            device.update(parse_info(info.out) if info.code == 0 else parse_info(""))
        self.devices = devices
        await self.load_card()
        await self.emit_state()

    async def load_card(self):
        result = await self.runner.run(["gpg", "--card-status", "--with-colons"], timeout=PROBE_TIMEOUT_S)
        self.card = parse_card(result.out) if result.code == 0 else None

    async def key_state(self):
        """missing / public / ready for the card's key, and whether it is ultimately trusted."""
        self.primary = ""
        if not self.card or not self.card["fingerprints"]:
            return "none", False
        fpr = self.card["fingerprints"][0]
        public = await self.runner.run(["gpg", "--list-keys", "--with-colons", fpr], timeout=GPG_TIMEOUT_S)
        if public.code != 0:
            return "missing", False
        self.primary, trust = primary_key(public.out)
        secret = await self.runner.run(["gpg", "--list-secret-keys", "--with-colons", fpr], timeout=GPG_TIMEOUT_S)
        return ("ready" if secret.code == 0 and secret.out.strip() else "public"), trust == "u"

    def pam_paths(self, pam):
        """The files the services that use pam_u2f read keys from."""
        own = os.path.normpath(self.paths.authfile)
        return {os.path.normpath(s["authfile"]) if s["authfile"] else own for s in pam.values() if s["u2f"]}

    def fido_target(self, pam=None):
        """Where a key registered now would go, and whether sudo and polkit would read it:
          own         the user's own list, which they read
          shared      the user's line of SHARED_AUTHFILE, through this package's helper
          no-pam      neither asks for a key (Omarchy's setup turns that on, and registers one)
          no-helper   they read SHARED_AUTHFILE, without the helper here to write to it
          other-file  they read a file the helper doesn't write
          mixed       they read different files, so a key would only work for one
        """
        paths = self.pam_paths(pam or self.pam_state())
        if not paths:
            return {"kind": "no-pam", "path": ""}
        if len(paths) > 1:
            return {"kind": "mixed", "path": ""}
        path = paths.pop()
        if path == os.path.normpath(self.paths.authfile):
            kind = "own"
        elif path != self.paths.shared_authfile:
            kind = "other-file"
        else:
            kind = "shared" if self.paths.shared_helper else "no-helper"
        return {"kind": kind, "path": path}

    def pin_required(self, pam=None):
        """Whether sudo or polkit only take a key with its PIN, so one without a PIN would never work."""
        return any(s["u2f"] and s["pin"] for s in (pam or self.pam_state()).values())

    def pin_mode(self, pam=None):
        """Whether the services that use pam_u2f ask for the PIN: "on", "off",
        "mixed" (only some do) or "" (none uses pam_u2f)."""
        pins = {s["pin"] for s in (pam or self.pam_state()).values() if s["u2f"]}
        if not pins:
            return ""
        return "mixed" if len(pins) > 1 else ("on" if pins.pop() else "off")

    def shared_credentials(self, target):
        return self.read_credentials(target["path"])[0] if target["kind"] == "shared" else []

    def read_credentials(self, path=None):
        try:
            with open(path or self.paths.authfile, encoding="utf-8") as f:
                lines = f.read().splitlines()
        except OSError:
            return [], []
        mine = []
        others = []
        for line in lines:
            if line.startswith(self.user + ":"):
                mine.extend(credential_handles(line, self.user))
            elif line.strip():
                others.append(line)
        return mine, others

    def pam_state(self):
        state = {}
        for service, name in (("sudo", "sudo"), ("polkit-1", "polkit")):
            path = self.paths.pam_file(service)
            try:
                with open(path, encoding="utf-8") as f:
                    state[name] = pam_u2f(f.read())
            except OSError:
                state[name] = {"u2f": False, "authfile": "", "pin": False}
        return state

    def shared_count(self, target):
        """How many of the user's keys the file sudo and polkit read holds, when
        it isn't the user's own list."""
        if target["kind"] not in ("shared", "no-helper", "other-file"):
            return 0
        try:
            with open(target["path"], encoding="utf-8") as f:
                return sum(len(credential_handles(line, self.user)) for line in f.read().splitlines())
        except OSError:
            return -1

    def ssh_keys(self):
        try:
            names = os.listdir(self.paths.ssh)
        except OSError:
            return []
        return sorted(n for n in names if RESIDENT.fullmatch(n) and not n.endswith(".pub"))

    def read_ssh(self, name):
        """A small file under ~/.ssh, as text, never through a symbolic link."""
        fd = os.open(os.path.join(self.paths.ssh, name), os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as f:
            data = f.read(SSH_FILE_LIMIT + 1)
        if len(data) > SSH_FILE_LIMIT:
            raise ValueError("%s is too large" % name)
        return data.decode("ascii")

    def ssh_public(self, name):
        try:
            return parse_public(self.read_ssh(name + ".pub"))
        except (OSError, ValueError, UnicodeError):
            return None

    def ssh_config_text(self):
        try:
            return self.read_ssh("config")
        except FileNotFoundError:
            return ""
        except (OSError, ValueError, UnicodeError):
            return None

    def drop_in(self, host):
        """What ~/.ssh/config.d/<host>.conf is: ("missing", [], None, None) or parse_drop_in()."""
        try:
            text = self.read_ssh(os.path.join("config.d", host + ".conf"))
        except FileNotFoundError:
            return "missing", [], None, None
        except (OSError, ValueError, UnicodeError):
            return "foreign", [], None, None
        return parse_drop_in(text)

    def ssh_entries(self):
        """The resident keys in ~/.ssh, with the git host their application names
        and whether its drop-in uses them: hostState "on", "off", "edited" (the
        drop-in changed by hand) or "foreign" (a file this helper didn't write),
        and the minutes it keeps connections to that host for (0 when none)."""
        config = self.ssh_config_text()
        included = config is not None and includes_drop_ins(config)
        entries = []
        for name in self.ssh_keys():
            public = self.ssh_public(name)
            application = public["application"] if public else ""
            remote = git_remote(application)
            host = remote[1] if remote else ""
            state = ""
            minutes = CONTROL_PERSIST_MINUTES
            if remote:
                kind, names, _, found = self.drop_in(host)
                state = {"missing": "off", "edited": "edited", "foreign": "foreign"}.get(kind)
                if kind == "ours":
                    state = "on" if name in names and included else "off"
                    minutes = found or 0
            entries.append({"name": name, "application": application, "host": host, "hostState": state,
                            "persistMinutes": minutes})
        return entries

    def ssh_defaults(self):
        """Suggestions for a new resident key: a random user ID (so keys for the
        same application don't replace each other on the key) and a comment."""
        hostname = re.sub(r"[^A-Za-z0-9._-]", "", socket.gethostname()) or "localhost"
        user = re.sub(r"[^A-Za-z0-9._-]", "", self.user) or "user"
        return {"user": secrets.token_hex(8), "comment": user + "@" + hostname}

    def plan_host(self, name, remote, enable, minutes=None):
        """The change to remote's drop-in that adds or takes out <name>: (path,
        text, or None to delete it), or None when nothing changes. <minutes>
        sets the host's connection reuse; otherwise the drop-in keeps its own.
        Raises SshConfigError when the drop-in isn't the helper's to change."""
        host = remote[1]
        kind, names, current, kept = self.drop_in(host)
        path = os.path.join(self.paths.ssh, "config.d", host + ".conf")
        minutes = kept or CONTROL_PERSIST_MINUTES if minutes is None else minutes
        if not enable:
            if kind == "ours" and name in names:
                rest = [n for n in names if n != name]
                return path, drop_in_text(rest, current, minutes) if rest else None
            if kind == "edited" and name in names:
                raise SshConfigError("ssh-config-edited", "~/.ssh/config.d/" + host + ".conf")
            return None
        if kind == "foreign":
            raise SshConfigError("ssh-config-foreign", "~/.ssh/config.d/" + host + ".conf")
        if kind == "edited":
            raise SshConfigError("ssh-config-edited", "~/.ssh/config.d/" + host + ".conf")
        if kind == "ours" and tuple(current) != tuple(remote):
            # Another key names the same host with another login or port.
            raise SshConfigError("ssh-config-conflict", host)
        text = drop_in_text(sorted(set(names) | {name}), remote, minutes)
        if kind == "ours" and name in names and text == drop_in_text(names, current, kept):
            return None
        return path, text

    def apply_host(self, change):
        if change is None:
            return
        path, text = change
        if text is None:
            if os.path.lexists(path):
                os.unlink(path)
            return
        directory = os.path.dirname(path)
        os.makedirs(directory, mode=0o700, exist_ok=True)
        if os.path.islink(directory) or not os.path.isdir(directory):
            raise SshConfigError("ssh-config-foreign", "~/.ssh/config.d")
        if "    ControlMaster auto\n" in text:
            # The master connections' sockets: private, as ssh requires.
            control = os.path.join(self.paths.ssh, CONTROL_DIR)
            os.makedirs(control, mode=0o700, exist_ok=True)
            if os.path.islink(control) or not os.path.isdir(control):
                raise SshConfigError("ssh-config-foreign", "~/.ssh/" + CONTROL_DIR)
            os.chmod(control, 0o700)
        replace_file(path, text, 0o600)

    def ensure_include(self):
        """Puts "Include config.d/*.conf" at the top of ~/.ssh/config, where it
        applies to every host, unless the file includes config.d already."""
        path = os.path.join(self.paths.ssh, "config")
        if os.path.islink(path):
            raise SshConfigError("ssh-config-link", "~/.ssh/config")
        text = self.ssh_config_text()
        if text is None:
            raise SshConfigError("ssh-config-foreign", "~/.ssh/config")
        if includes_drop_ins(text):
            return
        mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o600
        replace_file(path, SSH_INCLUDE + "\n" + ("\n" + text if text else ""), mode)

    async def emit_state(self):
        key_state, trusted = await self.key_state()
        pam = self.pam_state()
        target = self.fido_target(pam)
        own_unused = os.path.normpath(self.paths.authfile) not in self.pam_paths(pam)

        def entry(credential, unused):
            return {"handle": credential.split(",", 1)[0], "label": credential_label(credential), "unused": unused}

        # The order fido_remove() counts in.
        credentials = [entry(c, False) for c in self.shared_credentials(target)]
        credentials += [entry(c, own_unused) for c in self.read_credentials()[0]]
        self.emit({
            "type": "state",
            "devices": self.devices,
            "credentials": credentials,
            "target": target,
            "pinRequired": self.pin_required(pam),
            "pinMode": self.pin_mode(pam),
            "pinHelper": bool(self.paths.pam_helper),
            "sharedCount": self.shared_count(target),
            "card": self.card,
            "keyState": key_state,
            "trusted": trusted,
            "sshKeys": self.ssh_entries(),
            "sshDefaults": self.ssh_defaults(),
        })

    async def poll(self):
        """Notices a key plugged in or pulled out while nothing else runs."""
        devices = await self.list_devices()
        if [d["path"] for d in devices] != [d["path"] for d in self.devices]:
            await self.refresh()

    # -- FIDO2 -----------------------------------------------------------

    async def fido_register(self, pin):
        op = "fido.register"
        if not self.devices:
            self.fail(op, "no-device")
            return
        target = self.fido_target()
        store = target["path"] if target["kind"] == "shared" else ""
        if target["kind"] not in ("own", "shared"):
            self.fail(op, "generic", "sudo and polkit wouldn't read this key (%s)" % target["kind"])
            return
        if self.pin_required() and not self.devices[0].get("clientPin"):
            self.fail(op, "no-pin")
            return
        if await self.already_registered(self.read_credentials(store)[0]):
            self.fail(op, "already-registered")
            return
        self.emit({"type": "busy", "op": op, "stage": "touch"})
        # Without a terminal pamu2fcfg reads the PIN from stdin.
        result = await self.runner.run(["pamu2fcfg", "-u", self.user], stdin=(pin + "\n") if pin else None,
                                       timeout=TOUCH_TIMEOUT_S)
        if result.code != 0:
            code = "timeout" if result.err == "timeout" else fido_error(result.err, pin)
            log("pamu2fcfg failed:", last_line(result.err))
            self.fail(op, code, last_line(result.err))
            # The key may have been pulled out, or its PIN retries changed.
            await self.refresh()
            return
        new = credential_handles(last_line(result.out), self.user)
        if not new:
            self.fail(op, "generic", "pamu2fcfg")
            return
        if store:
            # The helper merges the line into the user's own and skips known keys.
            if await self.write_shared(op, store, "add", ":".join([self.user] + new)):
                self.emit({"type": "done", "op": op})
                await self.emit_state()
            return
        mine, others = self.read_credentials()
        if not self.write_credentials(merge_credentials(mine, new), others):
            self.fail(op, "write-failed", self.paths.authfile)
            return
        self.emit({"type": "done", "op": op})
        await self.emit_state()

    async def already_registered(self, credentials):
        """Whether the key plugged in made one of <credentials>. A credential only
        answers on its own key, and up=false asks for no touch. Anything else
        (another origin, a key that refuses to answer) just isn't a match."""
        origin = "pam://" + socket.gethostname()
        for credential in credentials:
            challenge = base64.b64encode(os.urandom(32)).decode()
            result = await self.runner.run(["fido2-assert", "-G", "-t", "up=false", self.devices[0]["path"]],
                                           stdin="%s\n%s\n%s\n" % (challenge, origin, credential.split(",", 1)[0]),
                                           timeout=PROBE_TIMEOUT_S)
            if result.code == 0:
                return True
        return False

    async def fido_remove(self, index):
        op = "fido.remove"
        target = self.fido_target()
        shared = self.shared_credentials(target)
        if 0 <= index < len(shared):
            if await self.write_shared(op, target["path"], "remove-key", shared[index].split(",", 1)[0]):
                self.emit({"type": "done", "op": op})
                await self.emit_state()
            return
        mine, others = self.read_credentials()
        index -= len(shared)
        if not 0 <= index < len(mine):
            self.fail(op, "generic", "no such key")
            return
        del mine[index]
        if not self.write_credentials(mine, others):
            self.fail(op, "write-failed", self.paths.authfile)
            return
        self.emit({"type": "done", "op": op})
        await self.emit_state()

    async def fido_pin(self, require):
        """Has sudo and polkit ask for the key's PIN along with the touch, or
        for a touch alone, through `pkexec omarchy-security-key-pam`."""
        op = "fido.pin"
        if not self.pin_mode():
            self.fail(op, "generic", "neither sudo nor polkit uses pam_u2f")
            return
        if not self.paths.pam_helper:
            self.fail(op, "generic", PAM_HELPER)
            return
        # The key plugged in couldn't sign in any more: it has no PIN to give.
        if require and self.devices and not self.devices[0].get("clientPin"):
            self.fail(op, "pin-unset")
            return
        self.emit({"type": "busy", "op": op, "stage": "auth"})
        action = "pin-on" if require else "pin-off"
        result = await self.runner.run(["pkexec", self.paths.pam_helper, action], timeout=AUTH_TIMEOUT_S)
        if result.code != 0:
            log("%s %s failed:" % (PAM_HELPER, action), last_line(result.err))
            refused = result.err == "timeout" or result.code in PKEXEC_REFUSED
            # Dismissed: "Couldn't save /etc/pam.d"; otherwise the helper's reason.
            self.fail(op, "not-authorized", "/etc/pam.d") if refused else self.fail(op, "pam-failed", last_line(result.err))
            return
        self.emit({"type": "done", "op": op, "require": require})
        await self.emit_state()

    async def write_shared(self, op, store, action, line):
        """Runs `pkexec omarchy-security-key-authfile <action>` with <line> on its
        stdin; reports the failure and returns False when it didn't go through."""
        self.emit({"type": "busy", "op": op, "stage": "auth"})
        result = await self.runner.run(["pkexec", self.paths.shared_helper, action], stdin=line + "\n",
                                       timeout=AUTH_TIMEOUT_S)
        if result.code == 0:
            return True
        log("%s %s failed:" % (SHARED_HELPER, action), last_line(result.err))
        refused = result.err == "timeout" or result.code in PKEXEC_REFUSED
        self.fail(op, "not-authorized" if refused else "write-failed", store)
        return False

    def write_credentials(self, mine, others):
        """Rewrites the authfile with <user>'s line (dropped when empty), atomically, 0600."""
        lines = list(others)
        if mine:
            lines.append(":".join([self.user] + mine))
        path = self.paths.authfile
        directory = os.path.dirname(path)
        try:
            os.makedirs(directory, mode=0o700, exist_ok=True)
            fd, tmp = tempfile.mkstemp(prefix=".u2f_keys.", dir=directory)
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write("".join(line + "\n" for line in lines))
                    f.flush()
                    os.fsync(f.fileno())
                os.chmod(tmp, 0o600)
                os.replace(tmp, path)
            except BaseException:
                os.unlink(tmp)
                raise
        except OSError as e:
            log("could not write %s: %s" % (path, e))
            return False
        return True

    # -- OpenPGP card ----------------------------------------------------

    async def gpg_import(self):
        op = "gpg.import"
        if not self.card:
            self.fail(op, "no-card")
            return
        updating = (await self.key_state())[0] == "ready"
        self.emit({"type": "busy", "op": op, "stage": "fetch"})
        imported = False
        url = self.card.get("url", "")
        if url.startswith(("https://", "http://", "hkps://", "hkp://")):
            result = await self.runner.run(["gpg", "--fetch-keys", url], timeout=NETWORK_TIMEOUT_S)
            imported = result.code == 0
            if not imported:
                log("gpg --fetch-keys failed:", last_line(result.err))
        if not imported and self.card["fingerprints"]:
            result = await self.runner.run(["gpg", "--recv-keys", self.card["fingerprints"][0]],
                                           timeout=NETWORK_TIMEOUT_S)
            imported = result.code == 0
            if not imported:
                log("gpg --recv-keys failed:", last_line(result.err))
        if not imported:
            self.fail(op, "import-failed")
            await self.emit_state()
            return
        # Reading the card again creates the secret-key stubs that point gpg at it.
        await self.runner.run(["gpg", "--card-status"], timeout=PROBE_TIMEOUT_S)
        self.emit({"type": "done", "op": op, "updated": updating})
        await self.emit_state()

    async def gpg_trust(self):
        op = "gpg.trust"
        await self.key_state()
        if not self.primary:
            self.fail(op, "trust-failed")
            return
        result = await self.runner.run(["gpg", "--import-ownertrust"], stdin="%s:6:\n" % self.primary,
                                       timeout=GPG_TIMEOUT_S)
        if result.code != 0:
            self.fail(op, "trust-failed", last_line(result.err))
            return
        self.emit({"type": "done", "op": op})
        await self.emit_state()

    async def gpg_remove(self):
        """Takes the card's key out of the keyring. Only ever stubs: a secret
        part kept on disk would be lost for good, so then nothing is removed."""
        op = "gpg.remove"
        await self.key_state()
        if not self.primary:
            self.fail(op, "remove-failed", "not in the keyring")
            return
        secret = await self.runner.run(["gpg", "--list-secret-keys", "--with-colons", self.primary],
                                       timeout=GPG_TIMEOUT_S)
        has_secret = secret.code == 0 and secret.out.strip() != ""
        if has_secret and secret_on_disk(secret.out):
            self.fail(op, "secret-on-disk")
            return
        what = "--delete-secret-and-public-keys" if has_secret else "--delete-keys"
        result = await self.runner.run(["gpg", "--batch", "--yes", what, self.primary], timeout=GPG_TIMEOUT_S)
        if result.code != 0:
            self.fail(op, "remove-failed", last_line(result.err))
            await self.emit_state()
            return
        self.emit({"type": "done", "op": op})
        await self.emit_state()

    # -- resident SSH keys -----------------------------------------------

    async def ssh_import(self, pin):
        op = "ssh.import"
        if not self.devices:
            self.fail(op, "no-device")
            return
        workdir = tempfile.mkdtemp(prefix="security-key-", dir=self.paths.runtime)
        server = None
        try:
            sock_path = os.path.join(workdir, "askpass")
            server = await serve_pin(sock_path, pin)
            env = dict(os.environ)
            env.update({"SSH_ASKPASS": self.askpass_command, "SSH_ASKPASS_REQUIRE": "force", ASKPASS_ENV: sock_path})
            env.setdefault("DISPLAY", ":0")
            self.emit({"type": "busy", "op": op, "stage": "touch"})
            result = await self.runner.run(["ssh-keygen", "-K", "-N", ""], env=env, cwd=workdir,
                                           timeout=TOUCH_TIMEOUT_S)
            found = sorted(n for n in os.listdir(workdir) if RESIDENT.fullmatch(n))
            if result.code != 0 and not found:
                code = "timeout" if result.err == "timeout" else fido_error(result.err, pin)
                log("ssh-keygen -K failed:", last_line(result.err))
                self.fail(op, code, last_line(result.err))
                # The key may have been pulled out, or its PIN retries changed.
                await self.refresh()
                return
            imported, skipped = self.install_ssh_keys(workdir, found)
            if not imported and not skipped:
                self.fail(op, "ssh-none")
                return
            self.emit({"type": "done", "op": op, "imported": imported, "skipped": skipped})
            await self.emit_state()
        finally:
            if server is not None:
                server.close()
            shutil.rmtree(workdir, ignore_errors=True)

    def host_change(self, name, enable):
        """plan_host() for the git host <name>'s application names, if any."""
        public = self.ssh_public(name)
        remote = git_remote(public["application"]) if public else None
        return self.plan_host(name, remote, enable) if remote else None

    def unlink_pair(self, name):
        for n in (name, name + ".pub"):
            path = os.path.join(self.paths.ssh, n)
            if os.path.lexists(path):
                os.unlink(path)

    async def ssh_remove(self, name):
        """Deletes one downloaded key (and its .pub) from ~/.ssh, and its line in
        the drop-in of its git host; only names sshKeys lists. The key itself
        stays on the security key."""
        op = "ssh.remove"
        if name not in self.ssh_keys():
            self.fail(op, "remove-failed", name)
            return
        try:
            change = self.host_change(name, False)
        except SshConfigError as e:
            self.fail(op, e.code, e.detail)
            return
        try:
            self.unlink_pair(name)
            self.apply_host(change)
        except (OSError, SshConfigError) as e:
            self.fail(op, "remove-failed", str(e))
            await self.emit_state()
            return
        self.emit({"type": "done", "op": op, "name": name})
        await self.emit_state()

    async def ssh_create(self, options, pin):
        """Makes a resident key on the security key (ssh-keygen -O resident), in
        a private folder, then copies its pair into ~/.ssh under the name
        `ssh-keygen -K` would give it, never over a file already there. A key
        with the same application and user ID on the security key is replaced
        only with "replace": the first try reports "ssh-exists"."""
        op = "ssh.create"
        problem = create_problem(options)
        if problem:
            self.fail(op, "ssh-invalid", problem)
            return
        if not self.devices:
            self.fail(op, "no-device")
            return
        name = handle_name(options["algorithm"], options["application"], options["user"])
        if any(os.path.lexists(os.path.join(self.paths.ssh, n)) for n in (name, name + ".pub")):
            self.fail(op, "ssh-file-exists", "~/.ssh/" + name)
            return
        workdir = tempfile.mkdtemp(prefix="security-key-", dir=self.paths.runtime)
        server = None
        try:
            server = await serve_pin(os.path.join(workdir, "askpass"), pin)
            env = dict(os.environ)
            env.update({"SSH_ASKPASS": self.askpass_command, "SSH_ASKPASS_REQUIRE": "force",
                        ASKPASS_ENV: os.path.join(workdir, "askpass")})
            env.setdefault("DISPLAY", ":0")
            self.emit({"type": "busy", "op": op, "stage": "touch"})
            # ssh-keygen asks on stdin before replacing a key on the security key.
            result = await self.runner.run(create_command(os.path.join(workdir, name), options),
                                           stdin="y\n" if options.get("replace") is True else "n\n",
                                           env=env, cwd=workdir, timeout=CREATE_TIMEOUT_S)
            made = all(os.path.exists(os.path.join(workdir, n)) for n in (name, name + ".pub"))
            if result.code != 0 or not made:
                if "Overwrite key in token" in result.out + result.err:
                    self.fail(op, "ssh-exists", "ssh:" + options["application"])
                    return
                code = "timeout" if result.err == "timeout" else fido_error(result.err, pin)
                log("ssh-keygen failed:", last_line(result.err))
                self.fail(op, code, last_line(result.err))
                await self.refresh()
                return
            imported, _ = self.install_ssh_keys(workdir, [name])
            if not imported:
                self.fail(op, "ssh-file-exists", "~/.ssh/" + name)
                return
            public = self.ssh_public(name)
            remote = git_remote(public["application"]) if public else None
            self.emit({"type": "done", "op": op, "name": name, "host": remote[1] if remote else "",
                       "publicKey": self.read_ssh(name + ".pub").strip()})
            await self.emit_state()
        finally:
            if server is not None:
                server.close()
            shutil.rmtree(workdir, ignore_errors=True)

    async def ssh_delete(self, name, pin):
        """Deletes the resident key behind ~/.ssh/<name> from the security key,
        for good, then the copy and its drop-in line. Only the exact credential
        of that copy (its key handle) is deleted: a copy of a key replaced since,
        or made on another security key, deletes nothing."""
        op = "ssh.delete"
        if name not in self.ssh_keys():
            self.fail(op, "remove-failed", name)
            return
        if not self.devices:
            self.fail(op, "no-device")
            return
        try:
            handle = parse_handle(self.read_ssh(name))
        except (OSError, ValueError, UnicodeError) as e:
            self.fail(op, "ssh-damaged", str(e))
            return
        public = self.ssh_public(name)
        if public is None or handle["blob"] != public["blob"]:
            self.fail(op, "ssh-damaged", "~/.ssh/" + name)
            return
        if handle["encrypted"]:
            self.fail(op, "ssh-encrypted", "~/.ssh/" + name)
            return
        # Checked before anything is deleted, so nothing is left half done.
        try:
            change = self.host_change(name, False)
        except SshConfigError as e:
            self.fail(op, e.code, e.detail)
            return
        device = self.devices[0]["path"]
        # Without a terminal fido2-token reads the PIN from stdin, once per run.
        listing = await self.runner.run(["fido2-token", "-L", "-k", public["application"], device],
                                        stdin=pin + "\n", timeout=AUTH_TIMEOUT_S)
        if listing.code != 0 and "NO_CREDENTIALS" not in listing.err:
            code = "timeout" if listing.err == "timeout" else fido_error(listing.err, pin)
            log("fido2-token -L -k failed:", last_line(listing.err))
            self.fail(op, code, last_line(listing.err))
            await self.refresh()
            return
        matches = [c for c in token_credentials(listing.out) if c["raw"] == handle["credential"]]
        if len(matches) != 1:
            self.fail(op, "ssh-not-on-key", "~/.ssh/" + name)
            return
        result = await self.runner.run(["fido2-token", "-D", "-i", matches[0]["id"], device],
                                       stdin=pin + "\n", timeout=AUTH_TIMEOUT_S)
        if result.code != 0:
            code = "timeout" if result.err == "timeout" else fido_error(result.err, pin)
            log("fido2-token -D failed:", last_line(result.err))
            self.fail(op, code, last_line(result.err))
            await self.refresh()
            return
        # The key is gone from the security key: its copy no longer works.
        try:
            self.unlink_pair(name)
            self.apply_host(change)
        except (OSError, SshConfigError) as e:
            log("cleaning up after deleting %s failed: %s" % (name, e))
        self.emit({"type": "done", "op": op, "name": name})
        await self.emit_state()

    async def ssh_host(self, name, enable, minutes=None):
        """Adds <name> to the drop-in of the git host its application names, or
        takes it out (the drop-in goes with its last key); the drop-in uses the
        keys for that host without the SSH agent. <minutes>, when given, sets
        the host's connection reuse too, as omarchy-yubikey asks for it when
        it sets a host up."""
        op = "ssh.host"
        if minutes is not None and not valid_minutes(minutes):
            self.fail(op, "ssh-invalid", "minutes")
            return
        entry = next((e for e in self.ssh_entries() if e["name"] == name), None)
        if entry is None or not entry["host"]:
            self.fail(op, "generic", name)
            return
        try:
            change = self.plan_host(name, git_remote(entry["application"]), enable, minutes)
            if enable:
                self.ensure_include()
            self.apply_host(change)
        except SshConfigError as e:
            self.fail(op, e.code, e.detail)
            return
        except OSError as e:
            self.fail(op, "write-failed", str(e))
            await self.emit_state()
            return
        self.emit({"type": "done", "op": op, "name": name, "host": entry["host"], "enabled": enable})
        await self.emit_state()

    async def ssh_persist(self, name, minutes):
        """Sets how long connections to the git host of <name>'s drop-in are
        reused: 0 authenticates each one, up to MAX_PERSIST_MINUTES keeps the
        authenticated master that long. The drop-in has to use the key already."""
        op = "ssh.persist"
        if not valid_minutes(minutes):
            self.fail(op, "ssh-invalid", "minutes")
            return
        entry = next((e for e in self.ssh_entries() if e["name"] == name), None)
        if entry is None or entry["hostState"] != "on":
            self.fail(op, "generic", name)
            return
        try:
            self.apply_host(self.plan_host(name, git_remote(entry["application"]), True, minutes))
        except SshConfigError as e:
            self.fail(op, e.code, e.detail)
            return
        except OSError as e:
            self.fail(op, "write-failed", str(e))
            await self.emit_state()
            return
        self.emit({"type": "done", "op": op, "name": name, "host": entry["host"], "minutes": minutes})
        await self.emit_state()

    def install_ssh_keys(self, workdir, names):
        """Moves the downloaded key files into ~/.ssh, never over an existing file."""
        os.makedirs(self.paths.ssh, mode=0o700, exist_ok=True)
        imported = []
        skipped = []
        for name in names:
            if name.endswith(".pub") or not RESIDENT.fullmatch(name):
                continue
            pair = [name, name + ".pub"]
            if any(os.path.exists(os.path.join(self.paths.ssh, n)) for n in pair):
                skipped.append(name)
                continue
            for n, mode in zip(pair, (0o600, 0o644)):
                source = os.path.join(workdir, n)
                if os.path.exists(source):
                    target = os.path.join(self.paths.ssh, n)
                    shutil.copyfile(source, target)
                    os.chmod(target, mode)
            imported.append(name)
        return imported, skipped


async def serve_pin(path, pin):
    """Answers the first PIN prompt of our own askpass over a socket only we can reach."""
    given = False

    async def answer(reader, writer):
        nonlocal given
        prompt = (await reader.readline()).decode("utf-8", "replace")
        reply = ""
        if pin and not given and "PIN" in prompt:
            reply = pin
            given = True
        writer.write((reply + "\n").encode())
        await writer.drain()
        writer.close()

    old = os.umask(0o077)
    try:
        return await asyncio.start_unix_server(answer, path=path)
    finally:
        os.umask(old)


def askpass(prompt):
    """SSH_ASKPASS mode: prints the PIN the helper hands over, or fails."""
    path = os.environ.get(ASKPASS_ENV, "")
    if not path:
        return 1
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(path)
            s.sendall((prompt.replace("\n", " ") + "\n").encode())
            reply = b""
            while not reply.endswith(b"\n"):
                chunk = s.recv(1024)
                if not chunk:
                    break
                reply += chunk
    except OSError:
        return 1
    answer = reply.decode("utf-8", "replace").rstrip("\n")
    if not answer:
        return 1
    print(answer)
    return 0


async def serve():
    loop = asyncio.get_running_loop()

    def emit(event):
        try:
            print(json.dumps(event), flush=True)
        except BrokenPipeError:
            stop.set()

    stop = asyncio.Event()
    command = os.path.abspath(__file__)
    session = Session(Runner(), emit, Paths(), os.environ.get("USER") or os.getlogin(), command)

    buffer = b""

    def on_stdin():
        nonlocal buffer
        try:
            chunk = os.read(sys.stdin.fileno(), 4096)
        except OSError:
            chunk = b""
        if not chunk:
            loop.remove_reader(sys.stdin.fileno())
            stop.set()
            return
        buffer += chunk
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            session.handle_line(line.decode("utf-8", "replace"))

    loop.add_reader(sys.stdin.fileno(), on_stdin)
    for signum in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(signum, stop.set)

    session.start("refresh", session.refresh())
    while not stop.is_set():
        try:
            await asyncio.wait_for(stop.wait(), POLL_S)
        except asyncio.TimeoutError:
            if session.op is None:
                session.start("refresh", session.poll())
    session.shutdown()
    await asyncio.sleep(0.2)


def main():
    # ssh-keygen runs SSH_ASKPASS with the prompt as its only argument; the
    # socket in the environment is what says this run is the askpass.
    if os.environ.get(ASKPASS_ENV):
        sys.exit(askpass(" ".join(sys.argv[1:])))
    asyncio.run(serve())


if __name__ == "__main__":
    main()
