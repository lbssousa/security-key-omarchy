#!/bin/bash

# omarchy:summary=Add or remove the calling user's FIDO2 keys in the pam_u2f authfile
# omarchy:requires-sudo=true
# omarchy:hidden=true
#
# Usage (through pkexec, as the overlay runs it):
#   pamu2fcfg -u "$USER" | pkexec omarchy-security-key-authfile add
#   echo <key handle> | pkexec omarchy-security-key-authfile remove-key
#
# Omarchy's FIDO2 setup keeps its registrations in /etc/fido2/fido2, with one
# line per user ("user:credential[:credential...]"), and writes it only once.
# The overlay has no root of its own, so this helper saves a key for it. It
# only ever touches one line: the one of the user pkexec says called it
# (PKEXEC_UID), never a name from the arguments or stdin. The
# org.omarchy.security-key.authfile polkit action asks for that user's own
# password or key.

set -euo pipefail

# Started by pkexec, take no paths or PATH from the caller. pkexec already
# clears the environment; this is the backstop.
if [[ -n ${PKEXEC_UID:-} ]]; then
  unset SECURITY_KEY_AUTHFILE_ROOT SECURITY_KEY_AUTHFILE_USER
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
fi

# The tests run as fake root against a fake tree, without pkexec.
root=${SECURITY_KEY_AUTHFILE_ROOT:-}
authfile=$root/etc/fido2/fido2
authdir=$(dirname "$authfile")
lockfile=$root/run/lock/omarchy-security-key-authfile.lock

die() {
  echo "$*" >&2
  exit 1
}

# Lines of the authfile other than <user>'s.
others() {
  [[ -f $authfile ]] || return 0
  awk -F: -v u="$1" '$1 != u && NF > 0' "$authfile"
}

current() {
  [[ -f $authfile ]] || return 0
  awk -F: -v u="$1" '$1 == u' "$authfile"
}

check_authdir() {
  if [[ -L $authdir || ( -e $authdir && ! -d $authdir ) ]]; then
    die "$authdir is not a FIDO2 configuration directory."
  fi
  if [[ -L $authfile || ( -e $authfile && ! -f $authfile ) ]]; then
    die "$authfile is not a FIDO2 registration file."
  fi
}

# Stdin to a sibling temp file, then rename: readers never see a half-written
# file, and the result belongs to root whatever was there before.
write_authfile() {
  local tmp
  tmp=$(mktemp "$authfile.new.XXXXXX")
  if ! cat >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  chmod 644 "$tmp"
  mv -Tf -- "$tmp" "$authfile"
}

do_add() {
  local user=$1 input creds line existing cred
  # One line, as pamu2fcfg -u prints it: "<user>:<credential>[:<credential>]".
  input=$(head -c 65536)
  input=${input%$'\n'}
  [[ $input != *$'\n'* ]] || die "Expected a single pamu2fcfg line."
  [[ ! $input =~ [[:cntrl:]] ]] || die "The pamu2fcfg line has control characters."
  [[ $input == "$user:"?* ]] || die "The pamu2fcfg line is not for $user."
  creds=${input#"$user:"}
  [[ $creds =~ ^[A-Za-z0-9+/=,_.:-]+$ ]] || die "The pamu2fcfg line is malformed."

  existing=$(current "$user")
  if [[ -n $existing ]]; then
    line=$existing
    IFS=':' read -r -a new_creds <<<"$creds"
    for cred in "${new_creds[@]}"; do
      [[ -n $cred ]] || continue
      # Same key registered again: keep one copy.
      if [[ ":${line#"$user:"}:" != *":$cred:"* ]]; then
        line+=":$cred"
      fi
    done
  else
    line="$user:$creds"
  fi

  install -d -m 755 "$authdir"
  { others "$user"; printf '%s\n' "$line"; } | write_authfile
  echo "FIDO2 key registered for $user."
}

# Drops the one credential whose key handle (its first field) comes on stdin;
# the line goes with its last credential.
do_remove_key() {
  local user=$1 handle existing cred kept=()
  handle=$(head -c 4096)
  handle=${handle%$'\n'}
  [[ $handle =~ ^[A-Za-z0-9+/=_-]+$ ]] || die "Expected one key handle."
  existing=$(current "$user")
  [[ -n $existing ]] || die "No FIDO2 keys registered for $user."
  IFS=':' read -r -a creds <<<"${existing#"$user:"}"
  for cred in "${creds[@]}"; do
    [[ -n $cred && ${cred%%,*} != "$handle" ]] && kept+=("$cred")
  done
  (( ${#kept[@]} < ${#creds[@]} )) || die "No such key registered for $user."
  {
    others "$user"
    (( ${#kept[@]} == 0 )) || (IFS=':'; printf '%s\n' "$user:${kept[*]}")
  } | write_authfile
  echo "FIDO2 key removed for $user."
}

action=${1:-}
case $action in
  add|remove-key) ;;
  *)
    echo "Usage: omarchy-security-key-authfile {add|remove-key}" >&2
    exit 2
    ;;
esac

(( EUID == 0 )) || die "Run through pkexec: pkexec omarchy-security-key-authfile $action"

if [[ -n ${PKEXEC_UID:-} ]]; then
  user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1) || true
  [[ -n $user ]] || die "Unknown caller (uid $PKEXEC_UID)."
else
  user=${SECURITY_KEY_AUTHFILE_USER:-}
  [[ -n $user ]] || die "Can't tell which user called (no PKEXEC_UID)."
fi
[[ $user =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] && getent passwd "$user" >/dev/null || die "Unknown user: $user"

check_authdir
mkdir -p "$(dirname "$lockfile")"
(
  flock -w 30 9 || die "Timed out waiting for the authfile lock."
  "do_${action//-/_}" "$user"
) 9>"$lockfile"
